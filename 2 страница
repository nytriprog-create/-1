<script>

/* =====================================================
   ИГРА 1 — ПОЙМАЙ КРУГ
===================================================== */

let targetScore = 0;

const target =
    document.getElementById("target");

const targetGame =
    document.getElementById("targetGame");

function moveTarget() {

    const maxX =
        targetGame.clientWidth - 55;

    const maxY =
        targetGame.clientHeight - 55;

    target.style.left =
        Math.random() * maxX + "px";

    target.style.top =
        Math.random() * maxY + "px";
}

target.addEventListener("pointerdown", function(e) {

    e.stopPropagation();

    targetScore++;

    document.getElementById(
        "targetScore"
    ).textContent = targetScore;

    moveTarget();
});

function startTargetGame() {

    targetScore = 0;

    document.getElementById(
        "targetScore"
    ).textContent = 0;

    moveTarget();
}

startTargetGame();


/* =====================================================
   ИГРА 2 — КАМЕНЬ НОЖНИЦЫ БУМАГА
===================================================== */

function playRPS(player) {

    const choices = [
        "Камень",
        "Ножницы",
        "Бумага"
    ];

    const computer =
        choices[
            Math.floor(
                Math.random() * choices.length
            )
        ];

    let result;

    if (player === computer) {

        result = "🤝 Ничья!";

    } else if (

        (player === "Камень" &&
         computer === "Ножницы") ||

        (player === "Ножницы" &&
         computer === "Бумага") ||

        (player === "Бумага" &&
         computer === "Камень")

    ) {

        result = "🏆 Ты победил!";

    } else {

        result = "🤖 Компьютер победил!";

    }

    document.getElementById(
        "rpsResult"
    ).innerHTML =
        `Ты: <b>${player}</b><br>
         Компьютер: <b>${computer}</b><br><br>
         ${result}`;
}


/* =====================================================
   ИГРА 3 — УГАДАЙ ЧИСЛО
===================================================== */

let secretNumber = 0;
let attempts = 0;

function newNumber() {

    secretNumber =
        Math.floor(Math.random() * 100) + 1;

    attempts = 0;

    document.getElementById(
        "guessMessage"
    ).textContent =
        "Новое число загадано!";

    document.getElementById(
        "guessInput"
    ).value = "";
}

function guessNumber() {

    const value =
        Number(
            document.getElementById(
                "guessInput"
            ).value
        );

    if (!value) return;

    attempts++;

    if (value === secretNumber) {

        document.getElementById(
            "guessMessage"
        ).textContent =
            `🎉 Угадал за ${attempts} попыток!`;

    } else if (value < secretNumber) {

        document.getElementById(
            "guessMessage"
        ).textContent =
            "⬆️ Моё число больше!";

    } else {

        document.getElementById(
            "guessMessage"
        ).textContent =
            "⬇️ Моё число меньше!";
    }
}

newNumber();


/* =====================================================
   ИГРА 4 — КЛИКЕР
===================================================== */

let clicks = 0;

function clicker() {

    clicks++;

    document.getElementById(
        "clickNumber"
    ).textContent = clicks;
}

function resetClicker() {

    clicks = 0;

    document.getElementById(
        "clickNumber"
    ).textContent = 0;
}


/* =====================================================
   ИГРА 5 — ЗАПОМНИ ЦВЕТ
===================================================== */

let colorStart = 0;
let colorWaiting = false;

function startColorGame() {

    const board =
        document.getElementById("colorBoard");

    const status =
        document.getElementById("colorStatus");

    board.style.background =
        "#aab1c4";

    board.textContent =
        "Жди...";

    status.textContent =
        "";

    colorWaiting = true;

    const delay =
        Math.random() * 3000 + 1500;

    colorStart =
        performance.now() + delay;

    setTimeout(() => {

        board.style.background =
            "#39d98a";

        board.textContent =
            "НАЖИМАЙ!";

        colorStart =
            performance.now();

    }, delay);
}

function colorClicked() {

    if (!colorWaiting) return;

    const now =
        performance.now();

    const board =
        document.getElementById("colorBoard");

    const status =
        document.getElementById("colorStatus");

    if (board.textContent === "НАЖИМАЙ!") {

        const reaction =
            Math.round(now - colorStart);

        status.textContent =
            `⚡ Твоя реакция: ${reaction} мс`;

        board.textContent =
            "Готово!";

        board.style.background =
            "#242b45";

        colorWaiting = false;

    } else {

        status.textContent =
            "😅 Слишком рано!";

        board.textContent =
            "Попробуй снова";

        board.style.background =
            "#d95757";

        colorWaiting = false;
    }
}


/* =====================================================
   ИГРА 6 — КОСМИЧЕСКИЙ ЛОВЕЦ
===================================================== */

const spaceCanvas =
    document.getElementById("spaceGame");

const spaceCtx =
    spaceCanvas.getContext("2d");

let spaceScore = 0;
let spaceRunning = false;
let star = {
    x: 100,
    y: 100,
    r: 16
};

function resizeSpaceCanvas() {

    const rect =
        spaceCanvas.getBoundingClientRect();

    const dpr =
        window.devicePixelRatio || 1;

    spaceCanvas.width =
        rect.width * dpr;

    spaceCanvas.height =
        rect.height * dpr;

    spaceCtx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
    );
}

function randomStar() {

    const rect =
        spaceCanvas.getBoundingClientRect();

    star.x =
        Math.random() * (rect.width - 40) + 20;

    star.y =
        Math.random() * (rect.height - 40) + 20;
}

function drawSpace() {

    if (!spaceRunning) return;

    const rect =
        spaceCanvas.getBoundingClientRect();

    spaceCtx.clearRect(
        0,
        0,
        rect.width,
        rect.height
    );

    /* звёзды */

    for (let i = 0; i < 35; i++) {

        const x =
            (i * 83) % rect.width;

        const y =
            (i * 47) % rect.height;

        spaceCtx.fillStyle =
            "rgba(255,255,255,.65)";

        spaceCtx.beginPath();

        spaceCtx.arc(
            x,
            y,
            1.5,
            0,
            Math.PI * 2
        );

        spaceCtx.fill();
    }

    /* главная звезда */

    spaceCtx.fillStyle = "#ffe477";

    spaceCtx.shadowColor = "#ffe477";
    spaceCtx.shadowBlur = 25;

    spaceCtx.beginPath();

    spaceCtx.arc(
        star.x,
        star.y,
        star.r,
        0,
        Math.PI * 2
    );

    spaceCtx.fill();

    spaceCtx.shadowBlur = 0;

    requestAnimationFrame(drawSpace);
}

spaceCanvas.addEventListener(
    "pointerdown",
    function(e) {

        if (!spaceRunning) return;

        const rect =
            spaceCanvas.getBoundingClientRect();

        const x =
            e.clientX - rect.left;

        const y =
            e.clientY - rect.top;

        const distance =
            Math.hypot(
                x - star.x,
                y - star.y
            );

        if (distance < star.r + 15) {

            spaceScore++;

            document.getElementById(
                "spaceScore"
            ).textContent =
                spaceScore;

            randomStar();
        }
    }
);

function startSpaceGame() {

    resizeSpaceCanvas();

    spaceScore = 0;

    document.getElementById(
        "spaceScore"
    ).textContent = 0;

    spaceRunning = true;

    randomStar();

    drawSpace();
}

window.addEventListener(
    "resize",
    resizeSpaceCanvas
);


/* =====================================================
   ИГРА 7 — ПАМЯТЬ
===================================================== */

const memorySymbols = [
    "🌙",
    "⭐",
    "🚀",
    "🪐",
    "🌙",
    "⭐",
    "🚀",
    "🪐"
];

let memoryFirst = null;
let memorySecond = null;
let memoryLock = false;

function startMemory() {

    const grid =
        document.getElementById(
            "memoryGrid"
        );

    grid.innerHTML = "";

    memoryFirst = null;
    memorySecond = null;
    memoryLock = false;

    const shuffled =
        [...memorySymbols]
        .sort(() => Math.random() - .5);

    shuffled.forEach(symbol => {

        const card =
            document.createElement("div");

        card.className =
            "memory-card";

        card.textContent = "❔";

        card.dataset.symbol =
            symbol;

        card.addEventListener(
            "click",
            () => openMemoryCard(card)
        );

        grid.appendChild(card);
    });
}

function openMemoryCard(card) {

    if (
        memoryLock ||
        card.classList.contains("open") ||
        card.classList.contains("done")
    ) return;

    card.classList.add("open");

    card.textContent =
        card.dataset.symbol;

    if (!memoryFirst) {

        memoryFirst = card;
        return;
    }

    memorySecond = card;

    if (
        memoryFirst.dataset.symbol ===
        memorySecond.dataset.symbol
    ) {

        memoryFirst.classList.add("done");
        memorySecond.classList.add("done");

        memoryFirst = null;
        memorySecond = null;

    } else {

        memoryLock = true;

        setTimeout(() => {

            memoryFirst.classList.remove("open");
            memorySecond.classList.remove("open");

            memoryFirst.textContent = "❔";
            memorySecond.textContent = "❔";

            memoryFirst = null;
            memorySecond = null;

            memoryLock = false;

        }, 700);
    }
}

startMemory();


/* =====================================================
   ИГРА 8 — РЕАКЦИЯ
===================================================== */

let reactionReady = false;
let reactionStart = 0;
let reactionTimer = null;

function startReaction() {

    const box =
        document.getElementById(
            "reactionBox"
        );

    const result =
        document.getElementById(
            "reactionResult"
        );

    reactionReady = false;

    box.style.background =
        "#202943";

    box.textContent =
        "Жди зелёного...";

    result.textContent = "";

    clearTimeout(reactionTimer);

    reactionTimer =
        setTimeout(() => {

            box.style.background =
                "#39d98a";

            box.textContent =
                "ЖМИ!";

            reactionReady = true;

            reactionStart =
                performance.now();

        }, Math.random() * 3500 + 1500);
}

function reactionClick() {

    const box =
        document.getElementById(
            "reactionBox"
        );

    const result =
        document.getElementById(
            "reactionResult"
        );

    if (reactionReady) {

        const time =
            Math.round(
                performance.now() -
                reactionStart
            );

        result.textContent =
            `⚡ Твоя реакция: ${time} мс`;

        box.textContent =
            "Готово!";

        box.style.background =
            "#202943";

        reactionReady = false;

    } else {

        if (box.textContent === "Жди зелёного...") {

            clearTimeout(reactionTimer);

            box.textContent =
                "❌ Слишком рано!";

            box.style.background =
                "#d95757";
        }
    }
}


/* =====================================================
   ИГРА 9 — МИНИ-РИСОВАНИЕ
===================================================== */

const miniCanvas =
    document.getElementById("miniCanvas");

const miniCtx =
    miniCanvas.getContext("2d");

let miniDrawing = false;

function resizeMiniCanvas() {

    const rect =
        miniCanvas.getBoundingClientRect();

    const dpr =
        window.devicePixelRatio || 1;

    miniCanvas.width =
        rect.width * dpr;

    miniCanvas.height =
        rect.height * dpr;

    miniCtx.setTransform(
        dpr,
        0,
        0,
        dpr,
        0,
        0
    );

    miniCtx.lineCap = "round";
    miniCtx.lineJoin = "round";
    miniCtx.lineWidth = 4;
    miniCtx.strokeStyle = "#202640";
}

function miniPosition(e) {

    const rect =
        miniCanvas.getBoundingClientRect();

    return {
        x: e.clientX - rect.left,
        y: e.clientY - rect.top
    };
}

miniCanvas.addEventListener(
    "pointerdown",
    e => {

        miniDrawing = true;

        const p =
            miniPosition(e);

        miniCtx.beginPath();

        miniCtx.moveTo(
            p.x,
            p.y
        );

        miniCanvas.setPointerCapture(
            e.pointerId
        );
    }
);

miniCanvas.addEventListener(
    "pointermove",
    e => {

        if (!miniDrawing) return;

        const p =
            miniPosition(e);

        miniCtx.lineTo(
            p.x,
            p.y
        );

        miniCtx.stroke();
    }
);

miniCanvas.addEventListener(
    "pointerup",
    () => {

        miniDrawing = false;

        miniCtx.closePath();
    }
);

function clearMiniCanvas() {

    const rect =
        miniCanvas.getBoundingClientRect();

    miniCtx.clearRect(
        0,
        0,
        rect.width,
        rect.height
    );
}

resizeMiniCanvas();

window.addEventListener(
    "resize",
    resizeMiniCanvas
);

</script>

